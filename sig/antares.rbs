module Antares
  VERSION: String
  COMPATIBILITY_VERSION: String
  COMPATIBILITY: Hash[String, :incremental | :window]
  COMPATIBILITY_DETAILS: Hash[String, Hash[Symbol, untyped]]

  class Error < StandardError
  end
  class UnsupportedLexerError < Error
  end
  class ResourceLimitError < Error
  end
  class GrammarError < Error
  end

  type strategy = :auto | :incremental | :window | :full
  type token = [Class, String]
  type row = Array[token]
  type structure_kind = :block | :comment | :string | :region | :token | :line

  interface _Structure
    def fold_regions: (?Range[Integer]? range) -> Array[Region]
    def brackets: (?Range[Integer]? range) -> Array[Bracket]
    def bracket_at: (Integer line, Integer column) -> Bracket?
    def context_at: (Integer line) -> Array[Region]
    def selection_ranges: (Integer line, Integer column) -> Array[Region]
    def edit: (from_line: Integer, removed: Integer, inserted: Integer) -> self
  end

  interface _StructureProvider
    def new: (lines: ^(Integer) -> String, line_count: ^() -> Integer,
      tokens_for: ^(Integer) -> row, tokens_in: ^(Range[Integer]) -> Array[row],
      stabilize: ^(Integer) -> Integer) -> _Structure
  end

  def self.compatible?: (untyped lexer) -> (:incremental | :window)

  module Grammar
    MAX_BYTES: Integer
    MAX_DEPTH: Integer
    MAX_RULES: Integer
    MAX_REGEX_BYTES: Integer
    def self.load_tmlanguage: (String path) -> untyped
  end

  class LexerStateSnapshot
    attr_reader fingerprint: String
    attr_reader bytesize: Integer
    def initialize: (untyped lexer, ?max_bytes: Integer) -> void
    def restore: () -> untyped
    def self.copy: (untyped value, ?Hash[Integer, untyped] memo) -> untyped
    def self.fingerprint: (untyped value) -> String
  end

  class Highlighter
    attr_reader strategy: strategy
    attr_reader requested_strategy: strategy
    attr_reader frontier: Integer
    attr_reader last_scanned_lines: Integer
    attr_reader fallback_reason: String?
    attr_reader checkpoints: Hash[Integer, LexerStateSnapshot]

    def initialize: (lexer: untyped, lines: ^(Integer) -> String, line_count: ^() -> Integer,
      ?strategy: strategy, ?checkpoint_interval: Integer, ?window_context: Integer,
      ?max_bytes: Integer, ?max_lines: Integer, ?max_line_bytes: Integer,
      ?max_checkpoint_bytes: Integer, ?max_seconds: Numeric) -> void
    def tokens_for: (Integer index) -> row
    def tokens_in: (Range[Integer] range) -> Array[row]
    def edit: (from_line: Integer, removed: Integer, inserted: Integer) -> self
    def advance: (until_line: Integer, ?from_line: Integer?) -> self
    def checkpoint_bytes: () -> Integer
    def structure: () -> _Structure
  end

  class ZaniahHighlighter
    def initialize: (lexer: untyped, buffer: untyped) -> void
    def tokens: (Integer index, String text) -> Array[[Range[Integer], Symbol]]
    def edited: (Range[Integer] range, String replacement) -> self
  end

  class Bracket < Struct[untyped]
    attr_accessor open_line: Integer
    attr_accessor open_column: Integer
    attr_accessor close_line: Integer
    attr_accessor close_column: Integer
    attr_accessor depth: Integer
    attr_accessor kind: String
    def self.new: (?open_line: Integer, ?open_column: Integer, ?close_line: Integer,
      ?close_column: Integer, ?depth: Integer, ?kind: String) -> Bracket
  end

  class Region < Struct[untyped]
    attr_accessor start_line: Integer
    attr_accessor end_line: Integer
    attr_accessor kind: structure_kind
    attr_accessor label: String
    attr_accessor start_column: Integer?
    attr_accessor end_column: Integer?
    def self.new: (?start_line: Integer, ?end_line: Integer, ?kind: structure_kind,
      ?label: String, ?start_column: Integer?, ?end_column: Integer?) -> Region
  end

  class Structure
    def self.register: (String | Symbol language, _StructureProvider provider) -> _StructureProvider
    def self.unregister: (String | Symbol language) -> untyped
    def initialize: (lines: ^(Integer) -> String, line_count: ^() -> Integer,
      tokens_for: ^(Integer) -> row, tokens_in: ^(Range[Integer]) -> Array[row],
      ?stabilize: ^(Integer) -> Integer) -> void
    def fold_regions: (?Range[Integer]? range) -> Array[Region]
    def brackets: (?Range[Integer]? range) -> Array[Bracket]
    def bracket_at: (Integer line, Integer column) -> Bracket?
    def context_at: (Integer line) -> Array[Region]
    def selection_ranges: (Integer line, Integer column) -> Array[Region]
    def edit: (from_line: Integer, removed: Integer, inserted: Integer) -> self
  end
end
